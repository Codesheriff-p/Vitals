<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<% function badgeClass(s) {
    switch (s) {
        case 'completed': return 'hms-badge-success';
        case 'scheduled': return 'hms-badge-warning';
        case 'cancelled': case 'no-show': return 'hms-badge-danger';
        default: return 'hms-badge-neutral';
    }
} %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/appointments">Appointments</a> / <%= appointment.appointment_number %></p>
        <h1 class="hms-page-title"><%= appointment.appointment_number %></h1>
    </div>
    <a href="/appointments/<%= appointment.id %>/edit" class="btn btn-outline-hms"><i class="bi bi-pencil me-1"></i> Edit</a>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="hms-card h-100">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Appointment Details</h6>
                <table class="table table-borderless table-sm mb-0">
                    <tr><td class="text-muted">Status</td><td><span class="hms-badge <%= badgeClass(appointment.status) %>"><%= appointment.status %></span></td></tr>
                    <tr><td class="text-muted">Date</td><td><%= new Date(appointment.appointment_date).toLocaleDateString('en-GB') %></td></tr>
                    <tr><td class="text-muted">Time</td><td><%= appointment.appointment_time %></td></tr>
                    <tr><td class="text-muted">Type</td><td><%= appointment.type %></td></tr>
                    <tr><td class="text-muted">Department</td><td><%= appointment.department_name || '—' %></td></tr>
                    <tr><td class="text-muted">Notes</td><td><%= appointment.notes || '—' %></td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="hms-card h-100">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Patient &amp; Doctor</h6>
                <table class="table table-borderless table-sm mb-3">
                    <tr><td class="text-muted" style="width:40%">Patient</td><td><a href="/patients/<%= appointment.patient_id %>"><%= appointment.patient_first_name %> <%= appointment.patient_last_name %></a></td></tr>
                    <tr><td class="text-muted">Patient #</td><td><%= appointment.patient_number %></td></tr>
                    <tr><td class="text-muted">Phone</td><td><%= appointment.patient_phone || '—' %></td></tr>
                    <tr><td class="text-muted">Doctor</td><td><a href="/doctors/<%= appointment.doctor_id %>">Dr. <%= appointment.doctor_name %></a></td></tr>
                </table>

                <h6 class="fw-semibold mb-2">Quick Actions</h6>
                <div class="d-flex flex-wrap gap-2">
                    <a href="/pharmacy/prescriptions/add?appointment_id=<%= appointment.id %>&patient_id=<%= appointment.patient_id %>" class="btn btn-sm btn-outline-hms"><i class="bi bi-capsule me-1"></i>Prescribe</a>
                    <a href="/laboratory/requests/add?appointment_id=<%= appointment.id %>&patient_id=<%= appointment.patient_id %>" class="btn btn-sm btn-outline-hms"><i class="bi bi-clipboard2-pulse me-1"></i>Request Lab Test</a>
                    <a href="/billing/add?appointment_id=<%= appointment.id %>&patient_id=<%= appointment.patient_id %>" class="btn btn-sm btn-outline-hms"><i class="bi bi-receipt me-1"></i>Generate Bill</a>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
