<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<% function calcAge(dob) {
    if (!dob) return '—';
    const d = new Date(dob);
    if (isNaN(d)) return '—';
    const diff = new Date(Date.now() - d.getTime());
    return Math.abs(diff.getUTCFullYear() - 1970);
} %>
<% function badgeClass(status) {
    switch (status) {
        case 'completed': case 'dispensed': case 'paid': case 'active': return 'hms-badge-success';
        case 'scheduled': case 'pending': case 'processing': case 'requested': case 'partial': return 'hms-badge-warning';
        case 'cancelled': case 'no-show': case 'unpaid': case 'inactive': return 'hms-badge-danger';
        default: return 'hms-badge-neutral';
    }
} %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/patients">Patients</a> / <%= patient.patient_number %></p>
        <h1 class="hms-page-title"><%= patient.first_name %> <%= patient.last_name %></h1>
    </div>
    <div class="d-flex gap-2">
        <a href="/patients/<%= patient.id %>/edit" class="btn btn-outline-hms"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a href="/appointments/add?patient_id=<%= patient.id %>" class="btn hms-btn-primary"><i class="bi bi-calendar-plus me-1"></i> New Appointment</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4">
        <div class="hms-card h-100">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Patient Information</h6>
                <table class="table table-borderless table-sm mb-0">
                    <tr><td class="text-muted">Patient #</td><td class="fw-semibold"><%= patient.patient_number %></td></tr>
                    <tr><td class="text-muted">Gender</td><td class="text-capitalize"><%= patient.gender %></td></tr>
                    <tr><td class="text-muted">Date of Birth</td><td><%= patient.dob ? new Date(patient.dob).toLocaleDateString('en-GB') : '—' %> <% if (patient.dob) { %>(<%= calcAge(patient.dob) %> yrs)<% } %></td></tr>
                    <tr><td class="text-muted">Blood Group</td><td><%= patient.blood_group || '—' %></td></tr>
                    <tr><td class="text-muted">Phone</td><td><%= patient.phone %></td></tr>
                    <tr><td class="text-muted">Email</td><td><%= patient.email || '—' %></td></tr>
                    <tr><td class="text-muted">Address</td><td><%= patient.address || '—' %></td></tr>
                    <tr><td class="text-muted">Next of Kin</td><td><%= patient.next_of_kin || '—' %></td></tr>
                    <tr><td class="text-muted">NOK Phone</td><td><%= patient.next_of_kin_phone || '—' %></td></tr>
                    <tr><td class="text-muted">Registered</td><td><%= new Date(patient.created_at).toLocaleDateString('en-GB') %></td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="hms-card mb-3">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Appointment History</h6>
                <% if (appointments.length) { %>
                <div class="table-responsive">
                    <table class="table hms-table align-middle">
                        <thead><tr><th>Appt #</th><th>Doctor</th><th>Date</th><th>Time</th><th>Status</th></tr></thead>
                        <tbody>
                        <% appointments.forEach(a => { %>
                            <tr>
                                <td><%= a.appointment_number %></td>
                                <td><%= a.doctor_name %></td>
                                <td><%= new Date(a.appointment_date).toLocaleDateString('en-GB') %></td>
                                <td><%= a.appointment_time %></td>
                                <td><span class="hms-badge <%= badgeClass(a.status) %>"><%= a.status %></span></td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div class="hms-empty-state py-4"><i class="bi bi-calendar-x"></i>No appointments on record.</div>
                <% } %>
            </div>
        </div>

        <div class="hms-card mb-3">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Medical Records</h6>
                <% if (medicalRecords.length) { %>
                <% medicalRecords.forEach(mr => { %>
                <div class="border-bottom pb-2 mb-2">
                    <div class="d-flex justify-content-between">
                        <span class="fw-semibold"><%= mr.diagnosis %></span>
                        <span class="text-muted small"><%= new Date(mr.created_at).toLocaleDateString('en-GB') %></span>
                    </div>
                    <div class="small text-muted">Dr. <%= mr.doctor_name %> — <%= mr.treatment || 'No treatment notes' %></div>
                </div>
                <% }); %>
                <% } else { %>
                <div class="hms-empty-state py-4"><i class="bi bi-file-medical"></i>No medical records on file.</div>
                <% } %>
            </div>
        </div>

        <div class="hms-card">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Billing History</h6>
                <% if (bills.length) { %>
                <div class="table-responsive">
                    <table class="table hms-table align-middle">
                        <thead><tr><th>Bill #</th><th>Total</th><th>Status</th><th>Date</th><th></th></tr></thead>
                        <tbody>
                        <% bills.forEach(b => { %>
                            <tr>
                                <td><%= b.bill_number %></td>
                                <td>₦<%= Number(b.total).toLocaleString('en-NG', {minimumFractionDigits: 2}) %></td>
                                <td><span class="hms-badge <%= badgeClass(b.status) %>"><%= b.status %></span></td>
                                <td><%= new Date(b.created_at).toLocaleDateString('en-GB') %></td>
                                <td class="text-end"><a href="/billing/<%= b.id %>" class="btn btn-sm btn-outline-hms">View</a></td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div class="hms-empty-state py-4"><i class="bi bi-receipt"></i>No bills on record.</div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
