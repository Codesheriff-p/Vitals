<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title + ' - HMS' : 'Hospital Management System' %></title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- App styles -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- Top Navbar -->
<nav class="navbar navbar-expand navbar-dark hms-navbar fixed-top">
    <div class="container-fluid">
        <button class="btn hms-sidebar-toggle d-flex align-items-center justify-content-center me-2" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
            <i class="bi bi-list"></i>
        </button>

        <a class="navbar-brand d-flex align-items-center gap-2" href="/dashboard">
            <i class="bi bi-heart-pulse-fill fs-4"></i>
            <span class="fw-semibold">VITALS HMS</span>
        </a>

        <div class="ms-auto d-flex align-items-center">
            <% if (typeof user !== 'undefined' && user) { %>
            <div class="dropdown">
                <button class="btn hms-user-btn dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="hms-avatar"><%= user.name.charAt(0).toUpperCase() %></span>
                    <span class="d-none d-sm-flex flex-column text-start lh-sm">
                        <span class="fw-semibold small"><%= user.name %></span>
                        <span class="text-capitalize hms-role-label"><%= user.role.replace('_', ' ') %></span>
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><h6 class="dropdown-header">Signed in as <%= user.role.replace('_', ' ') %></h6></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form action="/logout" method="POST" class="m-0">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
            <% } %>
        </div>
    </div>
</nav>

<div class="hms-layout">
