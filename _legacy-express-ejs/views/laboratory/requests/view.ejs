<%- include('../../partials/header') %>
<%- include('../../partials/sidebar') %>

<% function badgeClass(s) {
    switch (s) {
        case 'completed': return 'hms-badge-success';
        case 'processing': return 'hms-badge-info';
        case 'requested': case 'pending': return 'hms-badge-warning';
        default: return 'hms-badge-neutral';
    }
} %>
<% const canEnterResults = ['admin','lab_technician'].includes(user.role) && request.status !== 'completed'; %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/laboratory">Laboratory</a> / <a href="/laboratory/requests">Requests</a> / <%= request.request_number %></p>
        <h1 class="hms-page-title"><%= request.request_number %></h1>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="hms-card h-100">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Request Info</h6>
                <table class="table table-borderless table-sm mb-0">
                    <tr><td class="text-muted">Patient</td><td><a href="/patients/<%= request.patient_id %>"><%= request.patient_first_name %> <%= request.patient_last_name %></a></td></tr>
                    <tr><td class="text-muted">Patient #</td><td><%= request.patient_number %></td></tr>
                    <tr><td class="text-muted">Doctor</td><td>Dr. <%= request.doctor_name %></td></tr>
                    <tr><td class="text-muted">Status</td><td><span class="hms-badge <%= badgeClass(request.status) %>"><%= request.status %></span></td></tr>
                    <tr><td class="text-muted">Date</td><td><%= new Date(request.created_at).toLocaleDateString('en-GB') %></td></tr>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="hms-card">
    <div class="hms-card-body">
        <h6 class="fw-semibold mb-3">Test Results</h6>
        <% if (items.length) { %>
        <% if (canEnterResults) { %>
        <form action="/laboratory/requests/<%= request.id %>/results" method="POST">
            <div class="table-responsive">
                <table class="table hms-table align-middle">
                    <thead><tr><th>Test</th><th>Normal Range</th><th>Result</th><th>Notes</th><th>Status</th></tr></thead>
                    <tbody>
                        <% items.forEach(i => { %>
                        <tr>
                            <td class="fw-semibold">
                                <input type="hidden" name="item_id" value="<%= i.id %>">
                                <%= i.test_name %>
                            </td>
                            <td><%= i.normal_range || '—' %> <%= i.unit || '' %></td>
                            <td style="min-width:160px">
                                <% if (i.status === 'completed') { %>
                                    <%= i.result %>
                                    <input type="hidden" name="result" value="<%= i.result %>">
                                <% } else { %>
                                    <input type="text" class="form-control form-control-sm" name="result" placeholder="Enter result">
                                <% } %>
                            </td>
                            <td style="min-width:180px">
                                <% if (i.status === 'completed') { %>
                                    <%= i.result_notes || '—' %>
                                    <input type="hidden" name="result_notes" value="<%= i.result_notes || '' %>">
                                <% } else { %>
                                    <input type="text" class="form-control form-control-sm" name="result_notes" placeholder="Optional notes">
                                <% } %>
                            </td>
                            <td><span class="hms-badge <%= badgeClass(i.status) %>"><%= i.status %></span></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <button type="submit" class="btn hms-btn-primary mt-2"><i class="bi bi-check-lg me-1"></i> Save Results</button>
        </form>
        <% } else { %>
        <div class="table-responsive">
            <table class="table hms-table align-middle">
                <thead><tr><th>Test</th><th>Normal Range</th><th>Result</th><th>Notes</th><th>Status</th></tr></thead>
                <tbody>
                    <% items.forEach(i => { %>
                    <tr>
                        <td class="fw-semibold"><%= i.test_name %></td>
                        <td><%= i.normal_range || '—' %> <%= i.unit || '' %></td>
                        <td><%= i.result || '—' %></td>
                        <td><%= i.result_notes || '—' %></td>
                        <td><span class="hms-badge <%= badgeClass(i.status) %>"><%= i.status %></span></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } %>
        <% } else { %>
        <div class="hms-empty-state"><i class="bi bi-clipboard2-pulse"></i>No tests on this request.</div>
        <% } %>
    </div>
</div>

<%- include('../../partials/footer') %>
