<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/laboratory">Laboratory</a> / Edit</p>
        <h1 class="hms-page-title">Edit Lab Test — <%= test.test_name %></h1>
    </div>
</div>

<% if (errors && errors.length) { %>
<div class="alert alert-danger">
    <ul class="mb-0 ps-3"><% errors.forEach(e => { %><li><%= e %></li><% }); %></ul>
</div>
<% } %>

<div class="hms-card">
    <div class="hms-card-body">
        <form action="/laboratory/<%= test.id %>/edit" method="POST">
            <div class="row g-3">
                <div class="col-md-8">
                    <label for="test_name" class="form-label hms-required">Test Name</label>
                    <input type="text" class="form-control" id="test_name" name="test_name" value="<%= test.test_name || '' %>" required>
                </div>
                <div class="col-md-4">
                    <label for="price" class="form-label hms-required">Price (₦)</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="price" name="price" value="<%= test.price || '' %>" required>
                </div>
                <div class="col-12">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description" name="description" rows="2"><%= test.description || '' %></textarea>
                </div>
                <div class="col-md-6">
                    <label for="normal_range" class="form-label">Normal Range</label>
                    <input type="text" class="form-control" id="normal_range" name="normal_range" value="<%= test.normal_range || '' %>">
                </div>
                <div class="col-md-6">
                    <label for="unit" class="form-label">Unit</label>
                    <input type="text" class="form-control" id="unit" name="unit" value="<%= test.unit || '' %>">
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn hms-btn-primary"><i class="bi bi-check-lg me-1"></i> Save Changes</button>
                <a href="/laboratory" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
