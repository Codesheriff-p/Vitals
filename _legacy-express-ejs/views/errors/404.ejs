<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - HMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="hms-error-body">
    <div class="hms-error-card text-center">
        <i class="bi bi-signpost-split display-1 text-secondary"></i>
        <h1 class="mt-3 mb-2">404</h1>
        <p class="text-muted mb-4">The page you are looking for does not exist.</p>
        <a href="<%= user ? '/dashboard' : '/login' %>" class="btn hms-btn-primary">
            <i class="bi bi-arrow-left me-1"></i> Back to <%= user ? 'Dashboard' : 'Login' %>
        </a>
    </div>
</body>
</html>
