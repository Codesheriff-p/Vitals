<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/pharmacy">Pharmacy</a> / Add</p>
        <h1 class="hms-page-title">Add Drug</h1>
    </div>
</div>

<% if (errors && errors.length) { %>
<div class="alert alert-danger">
    <ul class="mb-0 ps-3"><% errors.forEach(e => { %><li><%= e %></li><% }); %></ul>
</div>
<% } %>

<div class="hms-card">
    <div class="hms-card-body">
        <form action="/pharmacy/add" method="POST">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="drug_name" class="form-label hms-required">Drug Name</label>
                    <input type="text" class="form-control" id="drug_name" name="drug_name" value="<%= formData.drug_name || '' %>" required>
                </div>
                <div class="col-md-6">
                    <label for="category" class="form-label">Category</label>
                    <input type="text" class="form-control" id="category" name="category" placeholder="e.g. Analgesic" value="<%= formData.category || '' %>">
                </div>
                <div class="col-12">
                    <label for="description" class="form-label">Description</label>
                    <textarea class="form-control" id="description" name="description" rows="2"><%= formData.description || '' %></textarea>
                </div>
                <div class="col-md-3">
                    <label for="unit" class="form-label">Unit</label>
                    <input type="text" class="form-control" id="unit" name="unit" placeholder="e.g. Tablet" value="<%= formData.unit || '' %>">
                </div>
                <div class="col-md-3">
                    <label for="unit_price" class="form-label hms-required">Unit Price (₦)</label>
                    <input type="number" step="0.01" min="0" class="form-control" id="unit_price" name="unit_price" value="<%= formData.unit_price || '' %>" required>
                </div>
                <div class="col-md-3">
                    <label for="quantity_in_stock" class="form-label hms-required">Quantity in Stock</label>
                    <input type="number" min="0" class="form-control" id="quantity_in_stock" name="quantity_in_stock" value="<%= formData.quantity_in_stock || '' %>" required>
                </div>
                <div class="col-md-3">
                    <label for="reorder_level" class="form-label">Reorder Level</label>
                    <input type="number" min="0" class="form-control" id="reorder_level" name="reorder_level" value="<%= formData.reorder_level || 10 %>">
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn hms-btn-primary"><i class="bi bi-check-lg me-1"></i> Save Drug</button>
                <a href="/pharmacy" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
