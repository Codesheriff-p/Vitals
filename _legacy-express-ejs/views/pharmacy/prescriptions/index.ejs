<%- include('../../partials/header') %>
<%- include('../../partials/sidebar') %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/pharmacy">Pharmacy</a> / Prescriptions</p>
        <h1 class="hms-page-title">Prescriptions</h1>
    </div>
    <div class="d-flex gap-2">
        <a href="/pharmacy" class="btn btn-outline-hms"><i class="bi bi-capsule me-1"></i> Inventory</a>
        <% if (['admin','doctor'].includes(user.role)) { %>
        <a href="/pharmacy/prescriptions/add" class="btn hms-btn-primary"><i class="bi bi-plus-lg me-1"></i> New Prescription</a>
        <% } %>
    </div>
</div>

<div class="hms-card mb-3">
    <div class="hms-card-body py-3">
        <form action="/pharmacy/prescriptions" method="GET" class="row g-2 align-items-center">
            <div class="col-md-3">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="dispensed" <%= status === 'dispensed' ? 'selected' : '' %>>Dispensed</option>
                </select>
            </div>
            <% if (status) { %>
            <div class="col-md-2"><a href="/pharmacy/prescriptions" class="btn btn-outline-secondary w-100">Clear</a></div>
            <% } %>
        </form>
    </div>
</div>

<div class="hms-card">
    <div class="hms-card-body">
        <% if (prescriptions.length) { %>
        <div class="table-responsive">
            <table class="table hms-table align-middle">
                <thead><tr><th>#</th><th>Patient</th><th>Doctor</th><th>Status</th><th>Date</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    <% prescriptions.forEach(p => { %>
                    <tr>
                        <td>#<%= p.id %></td>
                        <td><%= p.patient_first_name %> <%= p.patient_last_name %> <span class="text-muted small">(<%= p.patient_number %>)</span></td>
                        <td>Dr. <%= p.doctor_name %></td>
                        <td><span class="hms-badge <%= p.status === 'dispensed' ? 'hms-badge-success' : 'hms-badge-warning' %>"><%= p.status %></span></td>
                        <td><%= new Date(p.created_at).toLocaleDateString('en-GB') %></td>
                        <td class="text-end">
                            <a href="/pharmacy/prescriptions/<%= p.id %>" class="btn btn-sm btn-outline-hms" title="View"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="hms-empty-state"><i class="bi bi-file-earmark-medical"></i>No prescriptions found.</div>
        <% } %>
    </div>
</div>

<%- include('../../partials/footer') %>
