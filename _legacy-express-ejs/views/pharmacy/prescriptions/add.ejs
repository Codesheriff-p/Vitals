<%- include('../../partials/header') %>
<%- include('../../partials/sidebar') %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/pharmacy">Pharmacy</a> / <a href="/pharmacy/prescriptions">Prescriptions</a> / New</p>
        <h1 class="hms-page-title">New Prescription</h1>
    </div>
</div>

<% if (errors && errors.length) { %>
<div class="alert alert-danger">
    <ul class="mb-0 ps-3"><% errors.forEach(e => { %><li><%= e %></li><% }); %></ul>
</div>
<% } %>

<div class="hms-card">
    <div class="hms-card-body">
        <form action="/pharmacy/prescriptions/add" method="POST">
            <input type="hidden" name="appointment_id" value="<%= formData.appointment_id || '' %>">

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label for="patient_id" class="form-label hms-required">Patient</label>
                    <select class="form-select" id="patient_id" name="patient_id" required>
                        <option value="">Select patient...</option>
                        <% patients.forEach(p => { %>
                        <option value="<%= p.id %>" <%= String(formData.patient_id) === String(p.id) ? 'selected' : '' %>>
                            <%= p.first_name %> <%= p.last_name %> (<%= p.patient_number %>)
                        </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="doctor_id" class="form-label hms-required">Prescribing Doctor</label>
                    <select class="form-select" id="doctor_id" name="doctor_id" required>
                        <option value="">Select doctor...</option>
                        <% doctors.forEach(d => { %>
                        <option value="<%= d.id %>" <%= String(formData.doctor_id) === String(d.id) ? 'selected' : '' %>>Dr. <%= d.name %></option>
                        <% }); %>
                    </select>
                </div>
            </div>

            <h6 class="fw-semibold mb-3">Drug Items</h6>
            <div id="rxItems">
                <div class="row g-2 align-items-end rx-item mb-2">
                    <div class="col-md-4">
                        <label class="form-label small">Drug</label>
                        <select class="form-select" name="drug_id">
                            <option value="">Select drug...</option>
                            <% drugs.forEach(d => { %>
                            <option value="<%= d.id %>"><%= d.drug_name %> (<%= d.quantity_in_stock %> <%= d.unit %> in stock)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Dosage</label>
                        <input type="text" class="form-control" name="dosage" placeholder="e.g. 500mg twice daily">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Quantity</label>
                        <input type="number" min="1" class="form-control" name="quantity" value="1">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Instructions</label>
                        <input type="text" class="form-control" name="instructions" placeholder="e.g. After meals">
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger w-100 rx-remove-row" title="Remove"><i class="bi bi-x-lg"></i></button>
                    </div>
                </div>
            </div>

            <button type="button" id="rxAddRow" class="btn btn-sm btn-outline-hms mt-1">
                <i class="bi bi-plus-lg me-1"></i> Add Another Drug
            </button>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn hms-btn-primary"><i class="bi bi-check-lg me-1"></i> Save Prescription</button>
                <a href="/pharmacy/prescriptions" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('rxAddRow').addEventListener('click', function () {
        const container = document.getElementById('rxItems');
        const firstRow = container.querySelector('.rx-item');
        const clone = firstRow.cloneNode(true);
        clone.querySelectorAll('input').forEach(el => el.value = el.name === 'quantity' ? 1 : '');
        clone.querySelectorAll('select').forEach(el => el.selectedIndex = 0);
        container.appendChild(clone);
    });

    document.getElementById('rxItems').addEventListener('click', function (e) {
        const btn = e.target.closest('.rx-remove-row');
        if (!btn) return;
        const rows = document.querySelectorAll('.rx-item');
        if (rows.length > 1) {
            btn.closest('.rx-item').remove();
        }
    });
</script>

<%- include('../../partials/footer') %>
