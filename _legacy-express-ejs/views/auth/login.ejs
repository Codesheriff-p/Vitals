<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - HMS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="hms-login-body">

    <div class="hms-login-card">
        <div class="text-center mb-4">
            <div class="hms-login-logo">
                <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <h4 class="fw-bold mb-1">VITALS HMS</h4>
            <p class="text-muted small mb-0">Hospital Management System</p>
        </div>

        <% if (typeof error !== 'undefined' && error.length) { %>
            <% error.forEach(function (msg) { %>
            <div class="alert alert-danger py-2 small" role="alert"><%= msg %></div>
            <% }); %>
        <% } %>

        <% if (typeof success !== 'undefined' && success.length) { %>
            <% success.forEach(function (msg) { %>
            <div class="alert alert-success py-2 small" role="alert"><%= msg %></div>
            <% }); %>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label for="email" class="form-label hms-required">Email Address</label>
                <input type="email" class="form-control" id="email" name="email" placeholder="name@hms.com" required autofocus>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label hms-required">Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn hms-btn-primary w-100 py-2 mt-2">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </button>
        </form>

        <p class="text-center text-muted small mt-4 mb-0">&copy; <%= new Date().getFullYear() %> VITALS HMS. All rights reserved.</p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
