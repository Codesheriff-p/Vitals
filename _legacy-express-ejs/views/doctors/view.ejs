<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<% function badgeClass(status) {
    switch (status) {
        case 'completed': case 'active': return 'hms-badge-success';
        case 'scheduled': return 'hms-badge-warning';
        case 'cancelled': case 'no-show': case 'inactive': return 'hms-badge-danger';
        default: return 'hms-badge-neutral';
    }
} %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/doctors">Doctors</a> / Dr. <%= doctor.name %></p>
        <h1 class="hms-page-title">Dr. <%= doctor.name %></h1>
    </div>
    <% if (user.role === 'admin') { %>
    <a href="/doctors/<%= doctor.id %>/edit" class="btn btn-outline-hms"><i class="bi bi-pencil me-1"></i> Edit</a>
    <% } %>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="hms-card h-100">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Doctor Information</h6>
                <table class="table table-borderless table-sm mb-0">
                    <tr><td class="text-muted">Specialization</td><td class="fw-semibold"><%= doctor.specialization %></td></tr>
                    <tr><td class="text-muted">Department</td><td><%= doctor.department_name || '—' %></td></tr>
                    <tr><td class="text-muted">Qualification</td><td><%= doctor.qualification || '—' %></td></tr>
                    <tr><td class="text-muted">Phone</td><td><%= doctor.phone || '—' %></td></tr>
                    <tr><td class="text-muted">Email</td><td><%= doctor.email %></td></tr>
                    <tr><td class="text-muted">Status</td><td><span class="hms-badge <%= badgeClass(doctor.status) %>"><%= doctor.status %></span></td></tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="hms-card">
            <div class="hms-card-body">
                <h6 class="fw-semibold mb-3">Recent Appointments</h6>
                <% if (appointments.length) { %>
                <div class="table-responsive">
                    <table class="table hms-table align-middle">
                        <thead><tr><th>Appt #</th><th>Patient</th><th>Date</th><th>Time</th><th>Status</th></tr></thead>
                        <tbody>
                        <% appointments.forEach(a => { %>
                            <tr>
                                <td><%= a.appointment_number %></td>
                                <td><%= a.patient_first_name %> <%= a.patient_last_name %></td>
                                <td><%= new Date(a.appointment_date).toLocaleDateString('en-GB') %></td>
                                <td><%= a.appointment_time %></td>
                                <td><span class="hms-badge <%= badgeClass(a.status) %>"><%= a.status %></span></td>
                            </tr>
                        <% }); %>
                        </tbody>
                    </table>
                </div>
                <% } else { %>
                <div class="hms-empty-state py-4"><i class="bi bi-calendar-x"></i>No appointments on record.</div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
