<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="hms-page-header">
    <div>
        <p class="hms-breadcrumb"><a href="/dashboard">Home</a> / <a href="/doctors">Doctors</a> / Add</p>
        <h1 class="hms-page-title">Add Doctor</h1>
    </div>
</div>

<% if (errors && errors.length) { %>
<div class="alert alert-danger">
    <ul class="mb-0 ps-3">
        <% errors.forEach(e => { %><li><%= e %></li><% }); %>
    </ul>
</div>
<% } %>

<div class="hms-card">
    <div class="hms-card-body">
        <form action="/doctors/add" method="POST">
            <h6 class="fw-semibold mb-3">Account Details</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label for="name" class="form-label hms-required">Full Name</label>
                    <input type="text" class="form-control" id="name" name="name" placeholder="Dr. John Doe" value="<%= formData.name || '' %>" required>
                </div>
                <div class="col-md-6">
                    <label for="email" class="form-label hms-required">Email</label>
                    <input type="email" class="form-control" id="email" name="email" value="<%= formData.email || '' %>" required>
                </div>
                <div class="col-md-6">
                    <label for="password" class="form-label hms-required">Temporary Password</label>
                    <input type="password" class="form-control" id="password" name="password" minlength="6" required>
                    <div class="form-text">Minimum 6 characters. The doctor can change this after logging in.</div>
                </div>
            </div>

            <h6 class="fw-semibold mb-3">Professional Details</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="specialization" class="form-label hms-required">Specialization</label>
                    <input type="text" class="form-control" id="specialization" name="specialization" placeholder="e.g. Cardiologist" value="<%= formData.specialization || '' %>" required>
                </div>
                <div class="col-md-6">
                    <label for="department_id" class="form-label">Department</label>
                    <select class="form-select" id="department_id" name="department_id">
                        <option value="">Unassigned</option>
                        <% departments.forEach(d => { %>
                        <option value="<%= d.id %>" <%= String(formData.department_id) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="qualification" class="form-label">Qualification</label>
                    <input type="text" class="form-control" id="qualification" name="qualification" placeholder="e.g. MBBS, FWACS" value="<%= formData.qualification || '' %>">
                </div>
                <div class="col-md-6">
                    <label for="phone" class="form-label">Phone</label>
                    <input type="text" class="form-control" id="phone" name="phone" value="<%= formData.phone || '' %>">
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn hms-btn-primary"><i class="bi bi-check-lg me-1"></i> Save Doctor</button>
                <a href="/doctors" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
